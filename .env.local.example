# Supabase Postgres connection strings.
# Copy this file to .env.local and fill in the values from:
#   Supabase Dashboard → Project Settings → Database → Connection string

# Used by the Next.js app at runtime. Use the TRANSACTION-MODE pooler URL
# (port 6543) — required for Vercel serverless / connection multiplexing.
# Example: postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Direct connection (port 5432) — used by scripts/init-db.mjs and
# scripts/create-admin.mjs because DDL and admin tasks need a direct connection
# (the transaction pooler doesn't support prepared statements / advisory locks).
# Example: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL_DIRECT=
